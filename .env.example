# Supabase Environment Configuration Template
# Copy this file to .env or .env.local and populate with your Supabase Project Settings
# Found in: https://supabase.com/dashboard/project/_/settings/api

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key

# Razorpay Payment Gateway Configuration
# Get your Key ID from Razorpay Dashboard -> Settings -> API Keys (Test or Live mode)
# https://dashboard.razorpay.com/app/keys
VITE_RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id

